/target
**/*.rs.bk
*.pdb
.DS_Store

# Local runtime assets — never commit ROMs, BIOS, cores or player data
/cores/
/roms/
/saves/
/system/
*.sfc
# A ROM sintética do pacote de exemplo (gerada por scripts/gen_example_assets.py)
# é embutida no binário por include_bytes! — precisa estar no repositório.
!crates/app/assets/example/roms/*.sfc
# A ROM do Cheat Genius (montada de crates/app/cheat_genius/cheat_genius.s por
# scripts/build_cheat_genius.sh) também vai por include_bytes!.
!crates/app/cheat_genius/cheat_genius.sfc
*.smc
*.fig
*.swc
*.dylib
*.so
*.dll
*.srm
*.state
*.state[0-9]
shot-*.bmp

# Mocks regeneráveis (cargo run --example ra_osd_mock) — só os .png ficam
docs/mocks/*.bmp

# Config and secrets (the app's default config lives in ~/.config)
config.toml
.env
screenscraper.toml

# Pacote de exemplo do World Cup 2026 (ROM de hack — não commitar);
# o pacote seguro (platformer-example, open source) É commitado de propósito.
/exemplo-world-cup-2026.zip

# workspace do ZCode
.zcode/

# artefatos de runtime dos testes headless
/platformer-example/
.zcodeignore

# build local do flatpak (packaging/flatpak/build-flatpak.sh)
packaging/flatpak/.flatpak-build/
packaging/flatpak/.flatpak-repo/
packaging/core-asset/
